{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:graflume:spatial:schema:0.1",
  "title": "Graflume SpatialSpec",
  "description": "Closed, function-free SpatialSpec 0.1 contract for the optional GPU renderer.",
  "x-graflume-spec-version": "0.1",
  "x-graflume-runtime-output-limits": {
    "vertices": 2000000,
    "indices": 6000000,
    "pickTargets": 500000,
    "estimatedBytes": 268435456
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["layers"],
  "properties": {
    "specVersion": { "const": "0.1" },
    "title": { "type": "string", "maxLength": 512 },
    "theme": {
      "oneOf": [{ "type": "string", "minLength": 1, "maxLength": 128 }, { "$ref": "#/$defs/theme" }]
    },
    "background": { "$ref": "#/$defs/color" },
    "ariaLabel": { "type": "string", "maxLength": 1024 },
    "camera": { "$ref": "#/$defs/camera" },
    "lighting": { "$ref": "#/$defs/lighting" },
    "interaction": { "$ref": "#/$defs/interaction" },
    "accessibility": { "$ref": "#/$defs/accessibility" },
    "legend": {
      "oneOf": [{ "type": "boolean" }, { "$ref": "#/$defs/legend" }]
    },
    "highlights": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/highlight" }
    },
    "annotations": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/annotation" }
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/layer" }
    }
  },
  "$defs": {
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "extends": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "mode": { "enum": ["light", "dark"] },
        "colors": { "$ref": "#/$defs/themeColors" },
        "typography": { "$ref": "#/$defs/themeTypography" },
        "spacing": { "$ref": "#/$defs/themeSpacing" },
        "axis": { "$ref": "#/$defs/themeAxis" },
        "mark": { "$ref": "#/$defs/themeMark" },
        "legend": { "$ref": "#/$defs/themeLegend" },
        "motion": { "$ref": "#/$defs/themeMotion" }
      }
    },
    "themeColors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "background": { "type": "string", "minLength": 1, "maxLength": 128 },
        "panel": { "type": "string", "minLength": 1, "maxLength": 128 },
        "surface": { "type": "string", "minLength": 1, "maxLength": 128 },
        "text": { "type": "string", "minLength": 1, "maxLength": 128 },
        "mutedText": { "type": "string", "minLength": 1, "maxLength": 128 },
        "subtitle": { "type": "string", "minLength": 1, "maxLength": 128 },
        "axisTitle": { "type": "string", "minLength": 1, "maxLength": 128 },
        "axis": { "type": "string", "minLength": 1, "maxLength": 128 },
        "grid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "minorGrid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "focus": { "type": "string", "minLength": 1, "maxLength": 128 },
        "paletteMode": { "enum": ["fixed", "ggplot2-hue"] },
        "continuousInterpolation": { "enum": ["step", "rgb", "lab"] },
        "palette": { "$ref": "#/$defs/themeColorArray" },
        "sequential": { "$ref": "#/$defs/themeColorArray" },
        "diverging": { "$ref": "#/$defs/themeColorArray" }
      }
    },
    "themeColorArray": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "themeTypography": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fontFamily": { "type": "string", "minLength": 1, "maxLength": 512 },
        "fontSize": { "type": "number", "exclusiveMinimum": 0, "maximum": 2000 },
        "fontWeight": { "type": "number", "minimum": 0, "maximum": 2000 },
        "titleSize": { "type": "number", "exclusiveMinimum": 0, "maximum": 2000 },
        "titleWeight": { "type": "number", "minimum": 0, "maximum": 2000 },
        "subtitleSize": { "type": "number", "exclusiveMinimum": 0, "maximum": 2000 },
        "subtitleWeight": { "type": "number", "minimum": 0, "maximum": 2000 },
        "axisLabelSize": { "type": "number", "minimum": 0, "maximum": 2000 },
        "axisLabelWeight": { "type": "number", "minimum": 0, "maximum": 2000 },
        "axisTitleSize": { "type": "number", "minimum": 0, "maximum": 2000 },
        "axisTitleWeight": { "type": "number", "minimum": 0, "maximum": 2000 },
        "legendLabelSize": { "type": "number", "minimum": 0, "maximum": 2000 },
        "legendLabelWeight": { "type": "number", "minimum": 0, "maximum": 2000 },
        "legendTitleSize": { "type": "number", "minimum": 0, "maximum": 2000 },
        "legendTitleWeight": { "type": "number", "minimum": 0, "maximum": 2000 },
        "titlePosition": { "enum": ["plot", "panel"] },
        "titleAlign": { "enum": ["left", "center", "right"] },
        "lineHeight": { "type": "number", "exclusiveMinimum": 0, "maximum": 20 }
      }
    },
    "themeSpacing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "xs": { "type": "number", "minimum": 0, "maximum": 2000 },
        "sm": { "type": "number", "minimum": 0, "maximum": 2000 },
        "md": { "type": "number", "minimum": 0, "maximum": 2000 },
        "lg": { "type": "number", "minimum": 0, "maximum": 2000 },
        "xl": { "type": "number", "minimum": 0, "maximum": 2000 },
        "plotMargin": { "type": "number", "minimum": 0, "maximum": 2000 },
        "minimumTitleBlock": { "type": "number", "minimum": 0, "maximum": 2000 },
        "plotPadding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["top", "right", "bottom", "left"],
          "properties": {
            "top": { "type": "number", "minimum": 0, "maximum": 2000 },
            "right": { "type": "number", "minimum": 0, "maximum": 2000 },
            "bottom": { "type": "number", "minimum": 0, "maximum": 2000 },
            "left": { "type": "number", "minimum": 0, "maximum": 2000 }
          }
        }
      }
    },
    "themeAxis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lineWidth": { "type": "number", "minimum": 0, "maximum": 64 },
        "tickLength": { "type": "number", "minimum": 0, "maximum": 256 },
        "labelPadding": { "type": "number", "minimum": 0, "maximum": 256 },
        "gridLineWidth": { "type": "number", "minimum": 0, "maximum": 64 },
        "lineVisible": { "type": "boolean" },
        "boxVisible": { "type": "boolean" },
        "boxLineWidth": { "type": "number", "minimum": 0, "maximum": 64 },
        "boxExcludedMarks": {
          "type": "array",
          "maxItems": 256,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "ticksVisible": { "type": "boolean" },
        "gridX": { "type": "boolean" },
        "gridX2": { "type": "boolean" },
        "gridY": { "type": "boolean" },
        "gridY2": { "type": "boolean" },
        "gridOpacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "minorGridVisible": { "type": "boolean" },
        "minorGridLineWidth": { "type": "number", "minimum": 0, "maximum": 64 },
        "minorGridOpacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "emphasizeZero": { "type": "boolean" },
        "lineCap": { "enum": ["butt", "round", "square"] },
        "titleGap": { "type": "number", "minimum": 0, "maximum": 256 }
      }
    },
    "themeMark": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lineWidth": { "type": "number", "minimum": 0, "maximum": 64 },
        "pointRadius": { "type": "number", "minimum": 0, "maximum": 2000 },
        "barRadius": { "type": "number", "minimum": 0, "maximum": 2000 },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "defaultColor": { "type": "string", "minLength": 1, "maxLength": 128 },
        "lineColor": { "type": "string", "minLength": 1, "maxLength": 128 },
        "pointFill": { "type": "string", "minLength": 1, "maxLength": 128 },
        "pointStroke": { "type": "string", "minLength": 1, "maxLength": 128 },
        "pointStrokeWidth": { "type": "number", "minimum": 0, "maximum": 2000 },
        "pointColorMode": { "enum": ["theme", "series"] },
        "barFill": { "type": "string", "minLength": 1, "maxLength": 128 },
        "barStroke": { "type": "string", "minLength": 1, "maxLength": 128 },
        "barStrokeWidth": { "type": "number", "minimum": 0, "maximum": 2000 },
        "barWidthRatio": { "type": "number", "minimum": 0, "maximum": 1 },
        "histogramFill": { "type": "string", "minLength": 1, "maxLength": 128 },
        "histogramGap": { "type": "number", "minimum": 0, "maximum": 2000 },
        "boxplotFill": { "type": "string", "minLength": 1, "maxLength": 128 },
        "boxplotLineWidth": { "type": "number", "minimum": 0, "maximum": 2000 },
        "boxplotRadius": { "type": "number", "minimum": 0, "maximum": 2000 },
        "boxplotMedianStroke": { "type": "string", "minLength": 1, "maxLength": 128 },
        "piePalette": { "$ref": "#/$defs/themeColorArray" },
        "pieStroke": { "type": "string", "minLength": 1, "maxLength": 128 },
        "pieStrokeWidth": { "type": "number", "minimum": 0, "maximum": 2000 },
        "pieStartAngle": { "type": "number", "minimum": -1000000, "maximum": 1000000 },
        "pieDirection": { "enum": ["clockwise", "counterclockwise"] },
        "areaFill": { "type": "string", "minLength": 1, "maxLength": 128 },
        "areaStroke": { "type": "string", "minLength": 1, "maxLength": 128 },
        "areaStrokeVisible": { "type": "boolean" },
        "areaColorMode": { "enum": ["theme", "series"] },
        "lineCap": { "enum": ["butt", "round", "square"] },
        "lineJoin": { "enum": ["bevel", "round", "miter"] }
      }
    },
    "themeLegend": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "surfaceOpacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "borderWidth": { "type": "number", "minimum": 0, "maximum": 256 },
        "borderColor": { "type": "string", "minLength": 1, "maxLength": 128 },
        "cornerRadius": { "type": "number", "minimum": 0, "maximum": 256 },
        "swatchRadius": { "type": "number", "minimum": 0, "maximum": 256 },
        "swatchSize": { "type": "number", "minimum": 0, "maximum": 256 },
        "lineWidth": { "type": "number", "minimum": 0, "maximum": 256 },
        "pointRadius": { "type": "number", "minimum": 0, "maximum": 256 },
        "pointStrokeWidth": { "type": "number", "minimum": 0, "maximum": 256 },
        "lineCap": { "enum": ["butt", "round", "square"] },
        "continuousSamples": { "type": "integer", "minimum": 1, "maximum": 256 }
      }
    },
    "themeMotion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "duration": { "type": "number", "minimum": 0, "maximum": 1000000 },
        "easing": { "enum": ["linear", "ease", "ease-in", "ease-out", "ease-in-out"] }
      }
    },
    "finiteNumber": { "type": "number" },
    "positiveNumber": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000000000 },
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        { "$ref": "#/$defs/finiteNumber" },
        { "$ref": "#/$defs/finiteNumber" },
        { "$ref": "#/$defs/finiteNumber" }
      ],
      "items": false
    },
    "lonLat": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        { "type": "number", "minimum": -180, "maximum": 180 },
        { "type": "number", "minimum": -90, "maximum": 90 }
      ],
      "items": false
    },
    "color": {
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 128 },
        {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "number", "minimum": 0, "maximum": 255 }
        },
        {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "number", "minimum": 0, "maximum": 255 }
        }
      ]
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "projection": { "enum": ["perspective", "orthographic"] },
        "target": { "$ref": "#/$defs/vec3" },
        "yaw": { "type": "number", "minimum": -1000000, "maximum": 1000000 },
        "pitch": {
          "type": "number",
          "minimum": -1.5707963267948966,
          "maximum": 1.5707963267948966
        },
        "distance": { "type": "number", "minimum": 0.0001, "maximum": 1000000000 },
        "fov": { "type": "number", "minimum": 10, "maximum": 120 },
        "near": { "type": "number", "minimum": 0.000001, "maximum": 1000000 },
        "far": { "type": "number", "minimum": 0.00001, "maximum": 1000000000000 }
      }
    },
    "lighting": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ambient": { "type": "number", "minimum": 0, "maximum": 4 },
        "diffuse": { "type": "number", "minimum": 0, "maximum": 4 },
        "direction": { "$ref": "#/$defs/vec3" }
      }
    },
    "tooltip": {
      "oneOf": [
        { "type": "boolean" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": { "type": "string", "maxLength": 256 },
            "fields": {
              "type": "array",
              "maxItems": 64,
              "items": { "type": "string", "maxLength": 128 }
            }
          }
        }
      ]
    },
    "controlLabels": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "chart": { "type": "string", "maxLength": 256 },
        "toolbar": { "type": "string", "maxLength": 256 },
        "orbit": { "type": "string", "maxLength": 256 },
        "pan": { "type": "string", "maxLength": 256 },
        "zoomIn": { "type": "string", "maxLength": 256 },
        "zoomOut": { "type": "string", "maxLength": 256 },
        "reset": { "type": "string", "maxLength": 256 },
        "projection": { "type": "string", "maxLength": 256 },
        "fullscreen": { "type": "string", "maxLength": 256 },
        "exportPng": { "type": "string", "maxLength": 256 },
        "showAnnotations": { "type": "string", "maxLength": 256 },
        "hideAnnotations": { "type": "string", "maxLength": 256 },
        "instructions": { "type": "string", "maxLength": 256 },
        "contextLost": { "type": "string", "maxLength": 256 },
        "unavailable": { "type": "string", "maxLength": 256 }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "annotations": { "type": "boolean" }
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "orbit": { "type": "boolean" },
        "pan": { "type": "boolean" },
        "zoom": { "type": "boolean" },
        "wheel": { "enum": ["off", "modifier", "always"] },
        "picking": { "type": "boolean" },
        "tooltip": { "$ref": "#/$defs/tooltip" },
        "controls": {
          "oneOf": [{ "type": "boolean" }, { "$ref": "#/$defs/controls" }]
        },
        "labels": { "$ref": "#/$defs/controlLabels" },
        "selection": {
          "oneOf": [{ "type": "boolean" }, { "$ref": "#/$defs/selection" }]
        }
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string", "maxLength": 4096 },
        "table": { "type": "boolean" },
        "maxRows": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "navigation": {
          "oneOf": [
            { "type": "boolean" },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "pageRows": { "type": "integer", "minimum": 1, "maximum": 1000 },
                "wrap": { "type": "boolean" }
              }
            }
          ]
        },
        "linkedFocus": {
          "type": "object",
          "additionalProperties": false,
          "required": ["group", "key"],
          "properties": {
            "group": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,95}$"
            },
            "key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "not": { "enum": ["__proto__", "prototype", "constructor"] }
            }
          }
        }
      }
    },
    "primitive": { "type": ["string", "number", "boolean", "null"] },
    "highlightStyle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fill": { "type": "string", "minLength": 1, "maxLength": 128 },
        "stroke": { "type": "string", "minLength": 1, "maxLength": 128 },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "lineWidth": { "type": "number", "minimum": 0, "maximum": 64 },
        "dash": {
          "type": "array",
          "maxItems": 16,
          "items": { "type": "number", "minimum": 0, "maximum": 256 }
        },
        "padding": { "type": "number", "minimum": 0, "maximum": 256 },
        "radius": { "type": "number", "minimum": 0, "maximum": 256 }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["single", "multiple"] },
        "toggle": { "type": "boolean" },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "not": { "enum": ["__proto__", "prototype", "constructor"] }
        },
        "clearOnBackground": { "type": "boolean" },
        "clearOnEscape": { "type": "boolean" },
        "ariaLabel": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "\\S" },
        "highlight": { "$ref": "#/$defs/highlightStyle" }
      }
    },
    "legendItem": {
      "type": "object",
      "required": ["label"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "label": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "\\S" },
        "color": { "type": "string", "minLength": 1, "maxLength": 128 },
        "layerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "value": { "$ref": "#/$defs/primitive" },
        "symbol": { "enum": ["auto", "line", "point", "rect"] }
      }
    },
    "legend": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "categories" } }, "required": ["mode"] },
          "then": { "required": ["items"] }
        }
      ],
      "properties": {
        "visible": { "type": "boolean" },
        "mode": { "enum": ["auto", "layers", "categories", "continuous"] },
        "position": {
          "enum": [
            "top",
            "right",
            "bottom",
            "left",
            "inside-top-left",
            "inside-top-right",
            "inside-bottom-left",
            "inside-bottom-right"
          ]
        },
        "orientation": { "enum": ["auto", "horizontal", "vertical"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "\\S" },
        "field": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "not": { "enum": ["__proto__", "prototype", "constructor"] }
        },
        "layerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": { "$ref": "#/$defs/legendItem" }
        },
        "maxItems": { "type": "integer", "minimum": 1, "maximum": 200 },
        "interactive": { "type": "boolean" },
        "labels": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "show": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S" },
            "hide": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S" }
          }
        }
      }
    },
    "spatialDatumTarget": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "datum" },
        "layerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "datumIndex": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 1000,
              "uniqueItems": true,
              "items": { "type": "integer", "minimum": 0 }
            }
          ]
        },
        "field": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "not": { "enum": ["__proto__", "prototype", "constructor"] }
        },
        "value": { "$ref": "#/$defs/primitive" },
        "values": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/primitive" }
        }
      },
      "anyOf": [{ "required": ["datumIndex"] }, { "required": ["field"] }],
      "allOf": [
        {
          "if": { "required": ["field"] },
          "then": {
            "oneOf": [
              { "required": ["value"], "not": { "required": ["values"] } },
              { "required": ["values"], "not": { "required": ["value"] } }
            ]
          },
          "else": {
            "not": { "anyOf": [{ "required": ["value"] }, { "required": ["values"] }] }
          }
        }
      ]
    },
    "spatialTarget": {
      "oneOf": [
        { "$ref": "#/$defs/spatialDatumTarget" },
        {
          "type": "object",
          "required": ["type", "layerId"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "layer" },
            "layerId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^\\S(?:.*\\S)?$"
            }
          }
        },
        {
          "type": "object",
          "required": ["type", "position"],
          "additionalProperties": false,
          "properties": { "type": { "const": "point" }, "position": { "$ref": "#/$defs/vec3" } }
        },
        {
          "type": "object",
          "required": ["type", "min", "max"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "box" },
            "min": { "$ref": "#/$defs/vec3" },
            "max": { "$ref": "#/$defs/vec3" }
          }
        }
      ]
    },
    "highlight": {
      "type": "object",
      "required": ["target"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "target": { "$ref": "#/$defs/spatialTarget" },
        "fill": { "type": "string", "minLength": 1, "maxLength": 128 },
        "stroke": { "type": "string", "minLength": 1, "maxLength": 128 },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "lineWidth": { "type": "number", "minimum": 0, "maximum": 64 },
        "dash": {
          "type": "array",
          "maxItems": 16,
          "items": { "type": "number", "minimum": 0, "maximum": 256 }
        },
        "padding": { "type": "number", "minimum": 0, "maximum": 256 },
        "radius": { "type": "number", "minimum": 0, "maximum": 256 }
      }
    },
    "annotation": {
      "type": "object",
      "required": ["target", "text"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "target": { "$ref": "#/$defs/spatialTarget" },
        "text": { "type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S" },
        "detail": { "type": "string", "maxLength": 4000 },
        "placement": { "enum": ["auto", "top", "right", "bottom", "left"] },
        "offsetX": { "type": "number", "minimum": -10000, "maximum": 10000 },
        "offsetY": { "type": "number", "minimum": -10000, "maximum": 10000 },
        "connector": {
          "oneOf": [
            { "type": "boolean" },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "visible": { "type": "boolean" },
                "color": { "type": "string", "minLength": 1, "maxLength": 128 },
                "width": { "type": "number", "minimum": 0, "maximum": 64 },
                "dash": {
                  "type": "array",
                  "maxItems": 16,
                  "items": { "type": "number", "minimum": 0, "maximum": 256 }
                }
              }
            }
          ]
        },
        "style": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "background": { "type": "string", "minLength": 1, "maxLength": 128 },
            "border": { "type": "string", "minLength": 1, "maxLength": 128 },
            "color": { "type": "string", "minLength": 1, "maxLength": 128 },
            "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
            "fontSize": { "type": "number", "minimum": 1, "maximum": 2000 },
            "maxWidth": { "type": "number", "minimum": 1, "maximum": 2000 },
            "padding": { "type": "number", "minimum": 1, "maximum": 2000 },
            "align": { "enum": ["start", "center", "end"] }
          }
        }
      }
    },
    "numberArray": {
      "type": "array",
      "maxItems": 1000000,
      "items": { "$ref": "#/$defs/finiteNumber" }
    },
    "vec3Array": {
      "type": "array",
      "maxItems": 1000000,
      "items": { "$ref": "#/$defs/vec3" }
    },
    "colorArray": {
      "type": "array",
      "maxItems": 1000000,
      "items": { "$ref": "#/$defs/color" }
    },
    "labelArray": {
      "type": "array",
      "maxItems": 1000000,
      "items": { "type": "string", "maxLength": 1024 }
    },
    "surfaceWireOverlay": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "color": { "$ref": "#/$defs/color" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "surfaceContours": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "levels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/finiteNumber" }
        },
        "count": { "type": "integer", "minimum": 1, "maximum": 64 },
        "projection": { "enum": ["surface", "base", "both"] },
        "baseHeight": { "$ref": "#/$defs/finiteNumber" },
        "color": { "$ref": "#/$defs/color" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "maxSegments": { "type": "integer", "minimum": 1, "maximum": 250000 }
      },
      "not": { "required": ["levels", "count"] }
    },
    "surfaceGridMark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "surface" },
        "mode": { "const": "surface" },
        "color": { "$ref": "#/$defs/color" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "normalMode": { "enum": ["flat", "smooth"] },
        "wireframe": { "type": "boolean" },
        "wireOverlay": {
          "oneOf": [{ "type": "boolean" }, { "$ref": "#/$defs/surfaceWireOverlay" }]
        },
        "contours": { "$ref": "#/$defs/surfaceContours" }
      }
    },
    "meshMark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "surface" },
        "mode": { "const": "mesh" },
        "color": { "$ref": "#/$defs/color" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "normalMode": { "enum": ["flat", "smooth"] },
        "wireframe": { "type": "boolean" },
        "wireOverlay": {
          "oneOf": [{ "type": "boolean" }, { "$ref": "#/$defs/surfaceWireOverlay" }]
        },
        "contours": { "$ref": "#/$defs/surfaceContours" }
      }
    },
    "surfaceGridData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rows", "columns", "z"],
      "properties": {
        "rows": { "type": "integer", "minimum": 2, "maximum": 2048 },
        "columns": { "type": "integer", "minimum": 2, "maximum": 2048 },
        "z": { "$ref": "#/$defs/numberArray" },
        "x": { "type": "array", "maxItems": 2048, "items": { "$ref": "#/$defs/finiteNumber" } },
        "y": { "type": "array", "maxItems": 2048, "items": { "$ref": "#/$defs/finiteNumber" } },
        "values": { "$ref": "#/$defs/numberArray" }
      }
    },
    "triangle": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "integer", "minimum": 0 }
    },
    "meshData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["positions", "triangles"],
      "properties": {
        "positions": { "$ref": "#/$defs/vec3Array" },
        "triangles": {
          "type": "array",
          "maxItems": 2000000,
          "items": { "$ref": "#/$defs/triangle" }
        },
        "normals": { "$ref": "#/$defs/vec3Array" },
        "colors": { "$ref": "#/$defs/colorArray" },
        "labels": { "$ref": "#/$defs/labelArray" }
      }
    },
    "surfaceGridLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mark", "data"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^\\S(?:.*\\S)?$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "mark": { "$ref": "#/$defs/surfaceGridMark" },
        "data": { "$ref": "#/$defs/surfaceGridData" }
      }
    },
    "meshLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mark", "data"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^\\S(?:.*\\S)?$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "mark": { "$ref": "#/$defs/meshMark" },
        "data": { "$ref": "#/$defs/meshData" }
      }
    },
    "volumeTransferStop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offset", "color"],
      "properties": {
        "offset": { "type": "number", "minimum": 0, "maximum": 1 },
        "color": { "$ref": "#/$defs/color" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "volumeTransferFunction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stops"],
      "properties": {
        "stops": {
          "type": "array",
          "minItems": 2,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/volumeTransferStop" }
        },
        "interpolation": { "enum": ["linear", "step"] }
      }
    },
    "volumeWindowLevel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["window", "level"],
      "properties": {
        "window": { "type": "number", "exclusiveMinimum": 0 },
        "level": { "$ref": "#/$defs/finiteNumber" }
      }
    },
    "volumeResolution": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "integer", "minimum": 2, "maximum": 256 }
    },
    "volumeRender": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": { "enum": ["raycast", "mip", "minip", "average"] },
        "axis": { "enum": ["x", "y", "z"] },
        "resolution": { "$ref": "#/$defs/volumeResolution" },
        "samples": { "type": "integer", "minimum": 2, "maximum": 1024 },
        "interpolation": { "enum": ["nearest", "linear"] },
        "caps": { "enum": ["none", "front", "back", "both"] }
      }
    },
    "orthogonalVolumeSlice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "axis", "position"],
      "properties": {
        "type": { "const": "orthogonal" },
        "axis": { "enum": ["x", "y", "z"] },
        "position": { "type": "number", "minimum": 0, "maximum": 1 },
        "resolution": { "$ref": "#/$defs/volumeResolution" },
        "interpolation": { "enum": ["nearest", "linear"] },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "obliqueVolumeSlice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "origin", "normal"],
      "properties": {
        "type": { "const": "oblique" },
        "origin": { "$ref": "#/$defs/vec3" },
        "normal": { "$ref": "#/$defs/vec3" },
        "up": { "$ref": "#/$defs/vec3" },
        "size": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/positiveNumber" }
        },
        "resolution": { "$ref": "#/$defs/volumeResolution" },
        "interpolation": { "enum": ["nearest", "linear"] },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "volumeSlice": {
      "oneOf": [
        { "$ref": "#/$defs/orthogonalVolumeSlice" },
        { "$ref": "#/$defs/obliqueVolumeSlice" }
      ]
    },
    "volumeMark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "volume" },
        "mode": { "enum": ["volume", "isosurface"] },
        "isoValue": { "$ref": "#/$defs/finiteNumber" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "pointSize": { "type": "number", "minimum": 0.1, "maximum": 256 },
        "maxSamples": { "type": "integer", "minimum": 1, "maximum": 250000 },
        "colorLow": { "$ref": "#/$defs/color" },
        "colorHigh": { "$ref": "#/$defs/color" },
        "transferFunction": { "$ref": "#/$defs/volumeTransferFunction" },
        "windowLevel": { "$ref": "#/$defs/volumeWindowLevel" },
        "render": { "$ref": "#/$defs/volumeRender" },
        "slices": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/volumeSlice" }
        }
      }
    },
    "volumeData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimensions", "values"],
      "properties": {
        "dimensions": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "integer", "minimum": 2, "maximum": 256 }
        },
        "values": {
          "type": "array",
          "maxItems": 4194304,
          "items": { "$ref": "#/$defs/finiteNumber" }
        },
        "origin": { "$ref": "#/$defs/vec3" },
        "spacing": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/positiveNumber" }
        }
      }
    },
    "volumeLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mark", "data"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^\\S(?:.*\\S)?$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "mark": { "$ref": "#/$defs/volumeMark" },
        "data": { "$ref": "#/$defs/volumeData" }
      }
    },
    "vectorIntegration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "direction": { "enum": ["forward", "backward", "both"] },
        "initialStep": { "$ref": "#/$defs/positiveNumber" },
        "minStep": { "$ref": "#/$defs/positiveNumber" },
        "maxStep": { "$ref": "#/$defs/positiveNumber" },
        "tolerance": { "$ref": "#/$defs/positiveNumber" },
        "maxSteps": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "maxLength": { "$ref": "#/$defs/positiveNumber" },
        "minMagnitude": { "type": "number", "minimum": 0 }
      }
    },
    "coneMark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "vector" },
        "mode": { "const": "cone" },
        "color": { "$ref": "#/$defs/color" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "radius": { "$ref": "#/$defs/positiveNumber" },
        "scale": { "$ref": "#/$defs/positiveNumber" },
        "segments": { "type": "integer", "minimum": 5, "maximum": 48 },
        "integration": { "$ref": "#/$defs/vectorIntegration" },
        "magnitudeEncoding": { "enum": ["none", "color", "radius", "color-radius"] }
      }
    },
    "streamtubeMark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "vector" },
        "mode": { "const": "streamtube" },
        "color": { "$ref": "#/$defs/color" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "radius": { "$ref": "#/$defs/positiveNumber" },
        "scale": { "$ref": "#/$defs/positiveNumber" },
        "segments": { "type": "integer", "minimum": 5, "maximum": 48 },
        "integration": { "$ref": "#/$defs/vectorIntegration" },
        "magnitudeEncoding": { "enum": ["none", "color", "radius", "color-radius"] }
      }
    },
    "coneData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origins", "vectors"],
      "properties": {
        "origins": { "type": "array", "maxItems": 250000, "items": { "$ref": "#/$defs/vec3" } },
        "vectors": { "type": "array", "maxItems": 250000, "items": { "$ref": "#/$defs/vec3" } },
        "labels": {
          "type": "array",
          "maxItems": 250000,
          "items": { "type": "string", "maxLength": 1024 }
        },
        "colors": { "type": "array", "maxItems": 250000, "items": { "$ref": "#/$defs/color" } }
      }
    },
    "streamtubeData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths"],
      "properties": {
        "paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 1000000,
            "items": { "$ref": "#/$defs/vec3" }
          }
        },
        "magnitudes": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 1000000,
            "items": { "$ref": "#/$defs/finiteNumber" }
          }
        },
        "labels": {
          "type": "array",
          "maxItems": 4096,
          "items": { "type": "string", "maxLength": 1024 }
        },
        "colors": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/color" } }
      }
    },
    "vectorSeedGrid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimensions"],
      "properties": {
        "dimensions": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "integer", "minimum": 1, "maximum": 16 }
        },
        "jitter": { "type": "number", "minimum": 0, "maximum": 0.49 },
        "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
      }
    },
    "vectorFieldData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimensions", "vectors"],
      "properties": {
        "dimensions": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "integer", "minimum": 2, "maximum": 128 }
