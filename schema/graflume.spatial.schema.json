          "type": "array",
          "maxItems": 1000000,
          "items": { "$ref": "#/$defs/vec3" }
        },
        "origin": { "$ref": "#/$defs/vec3" },
        "spacing": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/positiveNumber" }
        },
        "seeds": {
          "type": "array",
          "maxItems": 4096,
          "items": { "$ref": "#/$defs/vec3" }
        },
        "seedGrid": { "$ref": "#/$defs/vectorSeedGrid" },
        "labels": {
          "type": "array",
          "maxItems": 4096,
          "items": { "type": "string", "maxLength": 1024 }
        },
        "colors": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/color" } }
      }
    },
    "coneLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mark", "data"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^\\S(?:.*\\S)?$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "mark": { "$ref": "#/$defs/coneMark" },
        "data": { "$ref": "#/$defs/coneData" }
      }
    },
    "streamtubeLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mark", "data"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^\\S(?:.*\\S)?$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "mark": { "$ref": "#/$defs/streamtubeMark" },
        "data": { "$ref": "#/$defs/streamtubeData" }
      }
    },
    "vectorFieldLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mark", "data"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^\\S(?:.*\\S)?$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "mark": { "$ref": "#/$defs/streamtubeMark" },
        "data": { "$ref": "#/$defs/vectorFieldData" }
      }
    },
    "scatterMark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "scatter" },
        "color": { "$ref": "#/$defs/color" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "pointSize": { "type": "number", "minimum": 0.1, "maximum": 256 }
      }
    },
    "scatterData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["positions"],
      "properties": {
        "positions": { "$ref": "#/$defs/vec3Array" },
        "values": { "$ref": "#/$defs/numberArray" },
        "sizes": {
          "type": "array",
          "maxItems": 1000000,
          "items": { "type": "number", "minimum": 0, "maximum": 1000 }
        },
        "colors": { "$ref": "#/$defs/colorArray" },
        "labels": { "$ref": "#/$defs/labelArray" }
      }
    },
    "scatterLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mark", "data"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^\\S(?:.*\\S)?$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "mark": { "$ref": "#/$defs/scatterMark" },
        "data": { "$ref": "#/$defs/scatterData" }
      }
    },
    "globePoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["longitude", "latitude"],
      "properties": {
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "value": { "$ref": "#/$defs/finiteNumber" },
        "label": { "type": "string", "maxLength": 1024 },
        "color": { "$ref": "#/$defs/color" },
        "size": { "type": "number", "minimum": 0, "maximum": 1000 }
      }
    },
    "globeRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "$ref": "#/$defs/lonLat" },
        "to": { "$ref": "#/$defs/lonLat" },
        "value": { "$ref": "#/$defs/finiteNumber" },
        "label": { "type": "string", "maxLength": 1024 },
        "color": { "$ref": "#/$defs/color" }
      }
    },
    "globeData": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "points": {
          "type": "array",
          "maxItems": 100000,
          "items": { "$ref": "#/$defs/globePoint" }
        },
        "routes": { "type": "array", "maxItems": 100000, "items": { "$ref": "#/$defs/globeRoute" } }
      }
    },
    "globeMark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "globe" },
        "radius": { "$ref": "#/$defs/positiveNumber" },
        "landColor": { "$ref": "#/$defs/color" },
        "oceanColor": { "$ref": "#/$defs/color" },
        "borderColor": { "$ref": "#/$defs/color" },
        "pointColor": { "$ref": "#/$defs/color" },
        "routeColor": { "$ref": "#/$defs/color" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "routeSegments": { "type": "integer", "minimum": 8, "maximum": 128 }
      }
    },
    "globeLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mark"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^\\S(?:.*\\S)?$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "mark": { "$ref": "#/$defs/globeMark" },
        "data": { "$ref": "#/$defs/globeData" }
      }
    },
    "layer": {
      "oneOf": [
        { "$ref": "#/$defs/surfaceGridLayer" },
        { "$ref": "#/$defs/meshLayer" },
        { "$ref": "#/$defs/volumeLayer" },
        { "$ref": "#/$defs/coneLayer" },
        { "$ref": "#/$defs/streamtubeLayer" },
        { "$ref": "#/$defs/vectorFieldLayer" },
        { "$ref": "#/$defs/scatterLayer" },
        { "$ref": "#/$defs/globeLayer" }
      ]
    }
  }
}
