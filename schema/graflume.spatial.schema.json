{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:graflume:spatial:schema:0.1",
  "title": "Graflume SpatialSpec",
  "description": "Closed, function-free SpatialSpec 0.1 contract for the optional GPU renderer.",
  "x-graflume-spec-version": "0.1",
  "x-graflume-runtime-output-limits": {
    "vertices": 2000000,
    "indices": 6000000,
    "pickTargets": 500000,
    "estimatedBytes": 268435456
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["layers"],
  "properties": {
    "specVersion": { "const": "0.1" },
    "title": { "type": "string", "maxLength": 512 },
    "background": { "$ref": "#/$defs/color" },
    "ariaLabel": { "type": "string", "maxLength": 1024 },
    "camera": { "$ref": "#/$defs/camera" },
    "lighting": { "$ref": "#/$defs/lighting" },
    "interaction": { "$ref": "#/$defs/interaction" },
    "accessibility": { "$ref": "#/$defs/accessibility" },
    "layers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/layer" }
    }
  },
  "$defs": {
    "finiteNumber": { "type": "number" },
    "positiveNumber": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000000000 },
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        { "$ref": "#/$defs/finiteNumber" },
        { "$ref": "#/$defs/finiteNumber" },
        { "$ref": "#/$defs/finiteNumber" }
      ],
      "items": false
    },
    "lonLat": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        { "type": "number", "minimum": -180, "maximum": 180 },
        { "type": "number", "minimum": -90, "maximum": 90 }
      ],
      "items": false
    },
    "color": {
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 128 },
        {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "number", "minimum": 0, "maximum": 255 }
        },
        {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "number", "minimum": 0, "maximum": 255 }
        }
      ]
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "projection": { "enum": ["perspective", "orthographic"] },
        "target": { "$ref": "#/$defs/vec3" },
        "yaw": { "type": "number", "minimum": -1000000, "maximum": 1000000 },
        "pitch": {
          "type": "number",
          "minimum": -1.5707963267948966,
          "maximum": 1.5707963267948966
        },
        "distance": { "type": "number", "minimum": 0.0001, "maximum": 1000000000 },
        "fov": { "type": "number", "minimum": 10, "maximum": 120 },
        "near": { "type": "number", "minimum": 0.000001, "maximum": 1000000 },
        "far": { "type": "number", "minimum": 0.00001, "maximum": 1000000000000 }
      }
    },
    "lighting": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ambient": { "type": "number", "minimum": 0, "maximum": 4 },
        "diffuse": { "type": "number", "minimum": 0, "maximum": 4 },
        "direction": { "$ref": "#/$defs/vec3" }
      }
    },
    "tooltip": {
      "oneOf": [
        { "type": "boolean" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": { "type": "string", "maxLength": 256 },
            "fields": {
              "type": "array",
              "maxItems": 64,
              "items": { "type": "string", "maxLength": 128 }
            }
          }
        }
      ]
    },
    "controlLabels": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "chart": { "type": "string", "maxLength": 256 },
        "toolbar": { "type": "string", "maxLength": 256 },
        "orbit": { "type": "string", "maxLength": 256 },
        "pan": { "type": "string", "maxLength": 256 },
        "zoomIn": { "type": "string", "maxLength": 256 },
        "zoomOut": { "type": "string", "maxLength": 256 },
        "reset": { "type": "string", "maxLength": 256 },
        "projection": { "type": "string", "maxLength": 256 },
        "fullscreen": { "type": "string", "maxLength": 256 },
        "exportPng": { "type": "string", "maxLength": 256 },
        "instructions": { "type": "string", "maxLength": 256 },
        "contextLost": { "type": "string", "maxLength": 256 },
        "unavailable": { "type": "string", "maxLength": 256 }
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "orbit": { "type": "boolean" },
        "pan": { "type": "boolean" },
        "zoom": { "type": "boolean" },
        "wheel": { "enum": ["off", "modifier", "always"] },
        "picking": { "type": "boolean" },
        "tooltip": { "$ref": "#/$defs/tooltip" },
        "controls": { "type": "boolean" },
        "labels": { "$ref": "#/$defs/controlLabels" }
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string", "maxLength": 4096 },
        "table": { "type": "boolean" },
        "maxRows": { "type": "integer", "minimum": 1, "maximum": 1000 }
      }
    },
    "numberArray": {
      "type": "array",
      "maxItems": 1000000,
      "items": { "$ref": "#/$defs/finiteNumber" }
    },
    "vec3Array": {
      "type": "array",
      "maxItems": 1000000,
      "items": { "$ref": "#/$defs/vec3" }
    },
    "colorArray": {
      "type": "array",
      "maxItems": 1000000,
      "items": { "$ref": "#/$defs/color" }
    },
    "labelArray": {
      "type": "array",
      "maxItems": 1000000,
      "items": { "type": "string", "maxLength": 1024 }
    },
    "surfaceGridMark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "surface" },
        "mode": { "const": "surface" },
        "color": { "$ref": "#/$defs/color" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "wireframe": { "type": "boolean" }
      }
    },
    "meshMark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "surface" },
        "mode": { "const": "mesh" },
        "color": { "$ref": "#/$defs/color" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "wireframe": { "type": "boolean" }
      }
    },
    "surfaceGridData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rows", "columns", "z"],
      "properties": {
        "rows": { "type": "integer", "minimum": 2, "maximum": 2048 },
        "columns": { "type": "integer", "minimum": 2, "maximum": 2048 },
        "z": { "$ref": "#/$defs/numberArray" },
        "x": { "type": "array", "maxItems": 2048, "items": { "$ref": "#/$defs/finiteNumber" } },
        "y": { "type": "array", "maxItems": 2048, "items": { "$ref": "#/$defs/finiteNumber" } },
        "values": { "$ref": "#/$defs/numberArray" }
      }
    },
    "triangle": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "integer", "minimum": 0 }
    },
    "meshData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["positions", "triangles"],
      "properties": {
        "positions": { "$ref": "#/$defs/vec3Array" },
        "triangles": {
          "type": "array",
          "maxItems": 2000000,
          "items": { "$ref": "#/$defs/triangle" }
        },
        "normals": { "$ref": "#/$defs/vec3Array" },
        "colors": { "$ref": "#/$defs/colorArray" },
        "labels": { "$ref": "#/$defs/labelArray" }
      }
    },
    "surfaceGridLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mark", "data"],
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "mark": { "$ref": "#/$defs/surfaceGridMark" },
        "data": { "$ref": "#/$defs/surfaceGridData" }
      }
    },
    "meshLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mark", "data"],
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "mark": { "$ref": "#/$defs/meshMark" },
        "data": { "$ref": "#/$defs/meshData" }
      }
    },
    "volumeMark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "volume" },
        "mode": { "enum": ["volume", "isosurface"] },
        "isoValue": { "$ref": "#/$defs/finiteNumber" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "pointSize": { "type": "number", "minimum": 0.1, "maximum": 256 },
        "maxSamples": { "type": "integer", "minimum": 1, "maximum": 250000 },
        "colorLow": { "$ref": "#/$defs/color" },
        "colorHigh": { "$ref": "#/$defs/color" }
      }
    },
    "volumeData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimensions", "values"],
      "properties": {
        "dimensions": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "integer", "minimum": 2, "maximum": 256 }
        },
        "values": {
          "type": "array",
          "maxItems": 4194304,
          "items": { "$ref": "#/$defs/finiteNumber" }
        },
        "origin": { "$ref": "#/$defs/vec3" },
        "spacing": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/positiveNumber" }
        }
      }
    },
    "volumeLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mark", "data"],
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "mark": { "$ref": "#/$defs/volumeMark" },
        "data": { "$ref": "#/$defs/volumeData" }
      }
    },
    "coneMark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "vector" },
        "mode": { "const": "cone" },
        "color": { "$ref": "#/$defs/color" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "radius": { "$ref": "#/$defs/positiveNumber" },
        "scale": { "$ref": "#/$defs/positiveNumber" },
        "segments": { "type": "integer", "minimum": 5, "maximum": 48 }
      }
    },
    "streamtubeMark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "vector" },
        "mode": { "const": "streamtube" },
        "color": { "$ref": "#/$defs/color" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "radius": { "$ref": "#/$defs/positiveNumber" },
        "scale": { "$ref": "#/$defs/positiveNumber" },
        "segments": { "type": "integer", "minimum": 5, "maximum": 48 }
      }
    },
    "coneData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origins", "vectors"],
      "properties": {
        "origins": { "type": "array", "maxItems": 250000, "items": { "$ref": "#/$defs/vec3" } },
        "vectors": { "type": "array", "maxItems": 250000, "items": { "$ref": "#/$defs/vec3" } },
        "labels": {
          "type": "array",
          "maxItems": 250000,
          "items": { "type": "string", "maxLength": 1024 }
        },
        "colors": { "type": "array", "maxItems": 250000, "items": { "$ref": "#/$defs/color" } }
      }
    },
    "streamtubeData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths"],
      "properties": {
        "paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 1000000,
            "items": { "$ref": "#/$defs/vec3" }
          }
        },
        "labels": {
          "type": "array",
          "maxItems": 4096,
          "items": { "type": "string", "maxLength": 1024 }
        },
        "colors": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/color" } }
      }
    },
    "coneLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mark", "data"],
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "mark": { "$ref": "#/$defs/coneMark" },
        "data": { "$ref": "#/$defs/coneData" }
      }
    },
    "streamtubeLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mark", "data"],
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "mark": { "$ref": "#/$defs/streamtubeMark" },
        "data": { "$ref": "#/$defs/streamtubeData" }
      }
    },
    "scatterMark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "scatter" },
        "color": { "$ref": "#/$defs/color" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "pointSize": { "type": "number", "minimum": 0.1, "maximum": 256 }
      }
    },
    "scatterData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["positions"],
      "properties": {
        "positions": { "$ref": "#/$defs/vec3Array" },
        "values": { "$ref": "#/$defs/numberArray" },
        "sizes": {
          "type": "array",
          "maxItems": 1000000,
          "items": { "type": "number", "minimum": 0, "maximum": 1000 }
        },
        "colors": { "$ref": "#/$defs/colorArray" },
        "labels": { "$ref": "#/$defs/labelArray" }
      }
    },
    "scatterLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mark", "data"],
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "mark": { "$ref": "#/$defs/scatterMark" },
        "data": { "$ref": "#/$defs/scatterData" }
      }
    },
    "globePoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["longitude", "latitude"],
      "properties": {
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "value": { "$ref": "#/$defs/finiteNumber" },
        "label": { "type": "string", "maxLength": 1024 },
        "color": { "$ref": "#/$defs/color" },
        "size": { "type": "number", "minimum": 0, "maximum": 1000 }
      }
    },
    "globeRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "$ref": "#/$defs/lonLat" },
        "to": { "$ref": "#/$defs/lonLat" },
        "value": { "$ref": "#/$defs/finiteNumber" },
        "label": { "type": "string", "maxLength": 1024 },
        "color": { "$ref": "#/$defs/color" }
      }
    },
    "globeData": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "points": {
          "type": "array",
          "maxItems": 100000,
          "items": { "$ref": "#/$defs/globePoint" }
        },
        "routes": { "type": "array", "maxItems": 100000, "items": { "$ref": "#/$defs/globeRoute" } }
      }
    },
    "globeMark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "globe" },
        "radius": { "$ref": "#/$defs/positiveNumber" },
        "landColor": { "$ref": "#/$defs/color" },
        "oceanColor": { "$ref": "#/$defs/color" },
        "borderColor": { "$ref": "#/$defs/color" },
        "pointColor": { "$ref": "#/$defs/color" },
        "routeColor": { "$ref": "#/$defs/color" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "routeSegments": { "type": "integer", "minimum": 8, "maximum": 128 }
      }
    },
    "globeLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mark"],
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "mark": { "$ref": "#/$defs/globeMark" },
        "data": { "$ref": "#/$defs/globeData" }
      }
    },
    "layer": {
      "oneOf": [
        { "$ref": "#/$defs/surfaceGridLayer" },
        { "$ref": "#/$defs/meshLayer" },
        { "$ref": "#/$defs/volumeLayer" },
        { "$ref": "#/$defs/coneLayer" },
        { "$ref": "#/$defs/streamtubeLayer" },
        { "$ref": "#/$defs/scatterLayer" },
        { "$ref": "#/$defs/globeLayer" }
      ]
    }
  }
}
