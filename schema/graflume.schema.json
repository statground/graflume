{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:graflume:schema:0.1",
  "title": "Graflume ChartSpec",
  "description": "Portable, versioned chart specification for Graflume 0.1.",
  "x-graflume-catalog": {
    "defaultFamilyCount": 22,
    "additionalFamilyCount": 11,
    "seriesFamilyCount": 8,
    "fullFamilyCount": 41,
    "defaultVariantCount": 39,
    "additionalVariantCount": 27,
    "seriesVariantCount": 96,
    "fullVariantCount": 162,
    "compatibilitySeriesCount": 117,
    "additionalMarks": [
      "radar",
      "polar",
      "tree",
      "graph",
      "chord",
      "funnel",
      "parallel",
      "boxplot",
      "image",
      "ternary",
      "smith",
      "scatter-matrix",
      "carpet",
      "effect-scatter",
      "lines",
      "heatmap",
      "pictorial-bar",
      "theme-river",
      "sunburst",
      "custom"
    ],
    "seriesMarks": [
      "arc-diagram",
      "bullet",
      "contour",
      "cylinder",
      "distribution",
      "financial",
      "flags",
      "geo-flow",
      "geo-heatmap",
      "geo-line",
      "indicator",
      "item",
      "lollipop",
      "packed-bubble",
      "pareto",
      "point-figure",
      "polygon",
      "pyramid",
      "range",
      "renko",
      "scatter-3d",
      "smooth",
      "solid-gauge",
      "tiled-map",
      "tilemap",
      "variable-pie",
      "variwide",
      "vector",
      "venn",
      "volume-profile",
      "wind-barb",
      "word-cloud"
    ],
    "builtInMarks": [
      "annotation",
      "arc-diagram",
      "area",
      "bar",
      "boxplot",
      "bubble",
      "bullet",
      "calendar",
      "candlestick",
      "chord",
      "contour",
      "custom",
      "cylinder",
      "diff",
      "distribution",
      "effect-scatter",
      "financial",
      "flags",
      "funnel",
      "gantt",
      "gauge",
      "geo",
      "geo-flow",
      "geo-heatmap",
      "geo-line",
      "graph",
      "heatmap",
      "histogram",
      "image",
      "indicator",
      "interval",
      "item",
      "line",
      "lines",
      "lollipop",
      "map",
      "motion",
      "org",
      "packed-bubble",
      "parallel",
      "pareto",
      "pictorial-bar",
      "pie",
      "polar",
      "point-figure",
      "point",
      "polygon",
      "pyramid",
      "radar",
      "range",
      "renko",
      "sankey",
      "scatter-3d",
      "scatter-matrix",
      "smooth",
      "solid-gauge",
      "stepped-area",
      "smith",
      "sunburst",
      "table",
      "theme-river",
      "tiled-map",
      "tilemap",
      "timeline",
      "ternary",
      "tree",
      "treemap",
      "trendline",
      "variable-pie",
      "variwide",
      "vega",
      "vector",
      "venn",
      "volume-profile",
      "waterfall",
      "wind-barb",
      "word-cloud",
      "word-tree",
      "carpet"
    ]
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "specVersion": {
      "const": "0.1",
      "default": "0.1"
    },
    "data": {
      "$ref": "#/$defs/data"
    },
    "mark": {
      "$ref": "#/$defs/mark"
    },
    "x": {
      "$ref": "#/$defs/xEncoding"
    },
    "y": {
      "$ref": "#/$defs/yEncoding"
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/layer"
      }
    },
    "width": {
      "oneOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "const": "container"
        }
      ]
    },
    "height": {
      "oneOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "const": "container"
        }
      ]
    },
    "padding": {
      "oneOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "$ref": "#/$defs/padding"
        }
      ]
    },
    "title": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/title"
        }
      ]
    },
    "description": {
      "type": "string"
    },
    "renderer": {
      "type": "string",
      "default": "auto"
    },
    "performance": {
      "enum": ["auto", "standard", "large", "ultra"],
      "default": "auto"
    },
    "theme": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object"
        }
      ]
    },
    "locale": {
      "type": "string"
    },
    "axes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "$ref": "#/$defs/xAxisOrFalse"
        },
        "x2": {
          "$ref": "#/$defs/xAxisOrFalse"
        },
        "y": {
          "$ref": "#/$defs/yAxisOrFalse"
        },
        "y2": {
          "$ref": "#/$defs/yAxisOrFalse"
        }
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hover": {
          "type": "boolean"
        },
        "click": {
          "type": "boolean"
        },
        "tooltip": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/tooltip"
            }
          ]
        },
        "navigation": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/navigation"
            }
          ]
        },
        "playback": {
          "oneOf": [
            {
              "const": false
            },
            {
              "$ref": "#/$defs/playback"
            }
          ]
        },
        "controls": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/controls"
            }
          ]
        }
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    }
  },
  "anyOf": [
    {
      "required": ["data", "mark", "x", "y"]
    },
    {
      "required": ["layers"]
    }
  ],
  "$defs": {
    "primitive": {
      "type": ["string", "number", "boolean", "null"]
    },
    "row": {
      "type": "object",
      "propertyNames": {
        "not": {
          "enum": ["__proto__", "prototype", "constructor"]
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/primitive"
      }
    },
    "data": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/row"
          }
        },
        {
          "type": "object",
          "required": ["columns"],
          "additionalProperties": false,
          "properties": {
            "columns": {
              "type": "object",
              "propertyNames": {
                "not": {
                  "enum": ["__proto__", "prototype", "constructor"]
                }
              },
              "additionalProperties": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/primitive"
                }
              }
            },
            "length": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "scale": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": ["linear", "band", "time"]
        },
        "domain": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": ["number", "string"]
          }
        },
        "zero": {
          "type": "boolean"
        },
        "nice": {
          "type": "boolean"
        },
        "clamp": {
          "type": "boolean"
        },
        "reverse": {
          "type": "boolean"
        },
        "paddingInner": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "paddingOuter": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "axisFont": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "family": {
          "type": "string",
          "minLength": 1
        },
        "size": {
          "type": "number",
          "minimum": 1,
          "maximum": 256
        },
        "weight": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 100,
              "maximum": 900
            },
            {
              "enum": ["normal", "medium", "semibold", "bold"]
            }
          ]
        },
        "style": {
          "enum": ["normal", "italic"]
        }
      }
    },
    "axisFormat": {
      "oneOf": [
        {
          "enum": [
            "auto",
            "number",
            "integer",
            "percent",
            "compact",
            "scientific",
            "currency",
            "date",
            "time",
            "datetime"
          ]
        },
        {
          "$ref": "#/$defs/axisFormatObject"
        }
      ]
    },
    "axisFormatObject": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": ["type", "currency"]
          },
          "then": {
            "properties": {
              "type": {
                "const": "currency"
              }
            }
          }
        }
      ],
      "properties": {
        "type": {
          "enum": [
            "auto",
            "number",
            "integer",
            "percent",
            "compact",
            "scientific",
            "currency",
            "date",
            "time",
            "datetime"
          ]
        },
        "fractionDigits": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "notation": {
          "enum": ["standard", "compact", "scientific", "engineering"]
        },
        "useGrouping": {
          "type": "boolean"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "currencyDisplay": {
          "enum": ["symbol", "narrowSymbol", "code", "name"]
        },
        "dateStyle": {
          "enum": ["short", "medium", "long", "full"]
        },
        "timeStyle": {
          "enum": ["short", "medium", "long"]
        },
        "timeZone": {
          "type": "string",
          "minLength": 1
        },
        "prefix": {
          "type": "string"
        },
        "suffix": {
          "type": "string"
        }
      }
    },
    "axisStroke": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "visible": {
          "type": "boolean"
        },
        "color": {
          "type": "string",
          "minLength": 1
        },
        "width": {
          "type": "number",
          "minimum": 0,
          "maximum": 32
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "dash": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 256
          }
        }
      }
    },
    "axisStrokeOrBoolean": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "$ref": "#/$defs/axisStroke"
        }
      ]
    },
    "axisTicks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "visible": {
          "type": "boolean"
        },
        "color": {
          "type": "string",
          "minLength": 1
        },
        "width": {
          "type": "number",
          "minimum": 0,
          "maximum": 32
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "dash": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 256
          }
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "spacing": {
          "type": "number",
          "minimum": 0,
          "maximum": 256
        },
        "size": {
          "type": "number",
          "minimum": 0,
          "maximum": 256
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "type": ["number", "string"]
          }
        }
      }
    },
    "axisTicksOrBoolean": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "$ref": "#/$defs/axisTicks"
        }
      ]
    },
    "axisLabels": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "visible": {
          "type": "boolean"
        },
        "orientation": {
          "enum": ["auto", "horizontal", "vertical-up", "vertical-down"]
        },
        "angle": {
          "type": "number",
          "minimum": -360,
          "maximum": 360
        },
        "align": {
          "enum": ["auto", "start", "center", "end"]
        },
        "padding": {
          "type": "number",
          "minimum": 0,
          "maximum": 256
        },
        "maxLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "color": {
          "type": "string",
          "minLength": 1
        },
        "font": {
          "$ref": "#/$defs/axisFont"
        }
      }
    },
    "axisLabelsOrBoolean": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "$ref": "#/$defs/axisLabels"
        }
      ]
    },
    "axisTitle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        },
        "visible": {
          "type": "boolean"
        },
        "align": {
          "enum": ["start", "center", "end"]
        },
        "angle": {
          "type": "number",
          "minimum": -360,
          "maximum": 360
        },
        "padding": {
          "type": "number",
          "minimum": 0,
          "maximum": 256
        },
        "color": {
          "type": "string",
          "minLength": 1
        },
        "font": {
          "$ref": "#/$defs/axisFont"
        }
      }
    },
    "axis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "const": false
            },
            {
              "$ref": "#/$defs/axisTitle"
            }
          ]
        },
        "visible": {
          "type": "boolean"
        },
        "position": {
          "enum": ["top", "bottom", "left", "right"]
        },
        "offset": {
          "type": "number",
          "minimum": 0,
          "maximum": 256
        },
        "line": {
          "$ref": "#/$defs/axisStrokeOrBoolean"
        },
        "grid": {
          "$ref": "#/$defs/axisStrokeOrBoolean"
        },
        "ticks": {
          "$ref": "#/$defs/axisTicksOrBoolean"
        },
        "labels": {
          "$ref": "#/$defs/axisLabelsOrBoolean"
        },
        "tickCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "format": {
          "$ref": "#/$defs/axisFormat"
        },
        "labelAngle": {
          "type": "number",
          "minimum": -360,
          "maximum": 360
        }
      }
    },
    "axisOrFalse": {
      "oneOf": [
        {
          "$ref": "#/$defs/axis"
        },
        {
          "const": false
        }
      ]
    },
    "xAxisOrFalse": {
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/axis"
            },
            {
              "properties": {
                "position": {
                  "enum": ["top", "bottom"]
                }
              }
            }
          ]
        },
        {
          "const": false
        }
      ]
    },
    "yAxisOrFalse": {
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/axis"
            },
            {
              "properties": {
                "position": {
                  "enum": ["left", "right"]
                }
              }
            }
          ]
        },
        {
          "const": false
        }
      ]
    },
    "tooltipField": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "not": {
            "enum": ["__proto__", "prototype", "constructor"]
          }
        },
        {
          "type": "object",
          "required": ["field"],
          "additionalProperties": false,
          "properties": {
            "field": {
              "type": "string",
              "minLength": 1,
              "not": {
                "enum": ["__proto__", "prototype", "constructor"]
              }
            },
            "label": {
              "type": "string"
            },
            "format": {
              "enum": ["auto", "number", "integer", "percent", "date", "datetime"]
            },
            "fractionDigits": {
              "type": "integer",
              "minimum": 0,
              "maximum": 6
            },
            "prefix": {
              "type": "string"
            },
            "suffix": {
              "type": "string"
            }
          }
        }
      ]
    },
    "tooltip": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": ["trigger"],
            "properties": {
              "trigger": {
                "const": "axis"
              }
            }
          },
          "then": {
            "required": ["axis"]
          }
        },
        {
          "if": {
            "required": ["axis"]
          },
          "then": {
            "required": ["trigger"],
            "properties": {
              "trigger": {
                "const": "axis"
              }
            }
          }
        }
      ],
      "properties": {
        "trigger": {
          "enum": ["mark", "axis"]
        },
        "axis": {
          "enum": ["x", "x2", "y", "y2"]
        },
        "title": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/tooltipField"
          }
        }
      }
    },
    "navigation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minZoom": {
          "type": "number",
          "minimum": 1,
          "maximum": 6
        },
        "maxZoom": {
          "type": "number",
          "minimum": 1,
          "maximum": 6
        },
        "wheel": {
          "enum": ["off", "modifier", "always"]
        },
        "drag": {
          "type": "boolean"
        },
        "pinch": {
          "type": "boolean"
        },
        "keyboard": {
          "type": "boolean"
        }
      }
    },
    "playback": {
      "type": "object",
      "required": ["field"],
      "additionalProperties": false,
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1,
          "not": {
            "enum": ["__proto__", "prototype", "constructor"]
          }
        },
        "layerId": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": ["frame", "cumulative", "window"]
        },
        "interval": {
          "type": "number",
          "minimum": 100,
          "maximum": 60000
        },
        "rate": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 16
        },
        "loop": {
          "type": "boolean"
        },
        "windowSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "autoplay": {
          "type": "boolean"
        },
        "filter": {
          "type": "boolean"
        }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "zoom": {
          "type": "boolean"
        },
        "reset": {
          "type": "boolean"
        },
        "fullscreen": {
          "type": "boolean"
        },
        "export": {
          "type": "boolean"
        },
        "playback": {
          "type": "boolean"
        },
        "labels": {
          "$ref": "#/$defs/controlLabels"
        }
      }
    },
    "controlLabels": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "controls": { "type": "string", "minLength": 1 },
        "zoomIn": { "type": "string", "minLength": 1 },
        "zoomOut": { "type": "string", "minLength": 1 },
        "reset": { "type": "string", "minLength": 1 },
        "enterFullscreen": { "type": "string", "minLength": 1 },
        "exitFullscreen": { "type": "string", "minLength": 1 },
        "exportPng": { "type": "string", "minLength": 1 },
        "previousFrame": { "type": "string", "minLength": 1 },
        "play": { "type": "string", "minLength": 1 },
        "pause": { "type": "string", "minLength": 1 },
        "nextFrame": { "type": "string", "minLength": 1 },
        "seek": { "type": "string", "minLength": 1 },
        "speed": { "type": "string", "minLength": 1 },
        "loop": { "type": "string", "minLength": 1 }
      }
    },
    "encodingObject": {
      "type": "object",
      "required": ["field"],
      "additionalProperties": false,
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1,
          "not": {
            "enum": ["__proto__", "prototype", "constructor"]
          }
        },
        "type": {
          "enum": ["quantitative", "temporal", "ordinal", "nominal"]
        },
        "title": {
          "type": "string"
        },
        "scale": {
          "$ref": "#/$defs/scale"
        },
        "axis": {
          "$ref": "#/$defs/axisOrFalse"
        },
        "axisId": {
          "enum": ["x", "x2", "y", "y2"]
        }
      }
    },
    "encoding": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "not": {
            "enum": ["__proto__", "prototype", "constructor"]
          }
        },
        {
          "$ref": "#/$defs/encodingObject"
        }
      ]
    },
    "xEncoding": {
      "allOf": [
        {
          "$ref": "#/$defs/encoding"
        },
        {
          "if": {
            "type": "object"
          },
          "then": {
            "properties": {
              "axisId": {
                "enum": ["x", "x2"]
              },
              "axis": {
                "$ref": "#/$defs/xAxisOrFalse"
              }
            }
          }
        }
      ]
    },
    "yEncoding": {
      "allOf": [
        {
          "$ref": "#/$defs/encoding"
        },
        {
          "if": {
            "type": "object"
          },
          "then": {
            "properties": {
              "axisId": {
                "enum": ["y", "y2"]
              },
              "axis": {
                "$ref": "#/$defs/yAxisOrFalse"
              }
            }
          }
        }
      ]
    },
    "markObject": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "description": "Built-in marks are listed in x-graflume-catalog; registered plugin mark names remain valid strings."
        },
        "stroke": {
          "type": "string"
        },
        "fill": {
          "type": "string"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "lineWidth": {
          "type": "number",
          "minimum": 0
        },
        "radius": {
          "type": "number",
          "minimum": 0
        },
        "cornerRadius": {
          "type": "number",
          "minimum": 0
        },
        "point": {
          "type": "boolean"
        },
        "position": {
          "enum": ["overlay", "group"]
        },
        "orientation": {
          "enum": ["vertical", "horizontal"]
        },
        "fields": {
          "type": "object",
          "propertyNames": {
            "not": {
              "enum": ["__proto__", "prototype", "constructor"]
            }
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "not": {
              "enum": ["__proto__", "prototype", "constructor"]
            }
          }
        },
        "options": {
          "type": "object",
          "propertyNames": {
            "not": {
              "enum": ["__proto__", "prototype", "constructor"]
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        }
      }
    },
    "jsonValue": {
      "oneOf": [
        {
          "$ref": "#/$defs/primitive"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "not": {
              "enum": ["__proto__", "prototype", "constructor"]
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        }
      ]
    },
    "mark": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "$ref": "#/$defs/markObject"
        }
      ]
    },
    "layer": {
      "type": "object",
      "required": ["mark", "x", "y"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "data": {
          "$ref": "#/$defs/data"
        },
        "mark": {
          "$ref": "#/$defs/mark"
        },
        "x": {
          "$ref": "#/$defs/xEncoding"
        },
        "y": {
          "$ref": "#/$defs/yEncoding"
        },
        "visible": {
          "type": "boolean"
        },
        "zIndex": {
          "type": "number"
        }
      }
    },
    "padding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "top": {
          "type": "number",
          "minimum": 0
        },
        "right": {
          "type": "number",
          "minimum": 0
        },
        "bottom": {
          "type": "number",
          "minimum": 0
        },
        "left": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "title": {
      "type": "object",
      "required": ["text"],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "align": {
          "enum": ["left", "center", "right"]
        }
      }
    }
  }
}
